# ==============================================================================
# Morphex — Sepolia Testnet Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your deployer credentials.

# Deployer wallet private key (preferred for testnets)
# Format: 0x... or 64 hex characters (must have Sepolia ETH for gas)
PRIVATE_KEY=

# Alternatively, a 12/24-word BIP-39 mnemonic phrase
MNEMONIC=

# Custom Sepolia RPC URL (optional, defaults to https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=

# Or API keys for RPC providers:
# ALCHEMY_API_KEY=
# INFURA_API_KEY=

# Etherscan API key for contract verification (optional)
# ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------
# Deployment Settings for deploy:relayer-pair / deploy:sepolia:core
# ------------------------------------------------------------------------------
# Deploy mock ERC20 tokens for USDC and USDT so public vault deposits & testing work
DEPLOY_MOCK_TOKENS=1

# Symbols to deploy (comma-separated, default: USDC,USDT)
DEPLOY_SYMBOLS=USDC,USDT

# Escape hatch delay in seconds for RelayerVault (default: 86400 = 1 day)
ESCAPE_HATCH_DELAY=86400
